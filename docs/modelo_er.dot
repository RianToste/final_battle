digraph ER {
  rankdir=LR; nodesep=0.5; ranksep=1.1; fontname="Helvetica";
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, arrowhead=none];
  labelloc="t"; label="Modelo Entidade-Relação - Jogo de Gestão"; fontsize=16;
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><B>users</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">username (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT">password_salt</TD></TR><TR><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  characters [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dbeafe"><B>characters</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_id (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">name (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">class</TD></TR><TR><TD ALIGN="LEFT">level</TD></TR><TR><TD ALIGN="LEFT">experience</TD></TR><TR><TD ALIGN="LEFT">health / max_health</TD></TR><TR><TD ALIGN="LEFT">energy</TD></TR><TR><TD ALIGN="LEFT">money</TD></TR><TR><TD ALIGN="LEFT">attack / defense / agility</TD></TR><TR><TD ALIGN="LEFT">wins / losses</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  items [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fef3c7"><B>items</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT">price</TD></TR><TR><TD ALIGN="LEFT">stock</TD></TR><TR><TD ALIGN="LEFT">effect_type</TD></TR><TR><TD ALIGN="LEFT">effect_value</TD></TR></TABLE>>];
  inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fef9c3"><B>inventory</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK,FK character_id</TD></TR><TR><TD ALIGN="LEFT">PK,FK item_id</TD></TR><TR><TD ALIGN="LEFT">quantity</TD></TR></TABLE>>];
  transactions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fef9c3"><B>transactions</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK character_id</TD></TR><TR><TD ALIGN="LEFT">FK item_id</TD></TR><TR><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT">quantity</TD></TR><TR><TD ALIGN="LEFT">unit_price</TD></TR><TR><TD ALIGN="LEFT">total</TD></TR><TR><TD ALIGN="LEFT">balance_before</TD></TR><TR><TD ALIGN="LEFT">balance_after</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  enemies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fee2e2"><B>enemies</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">level</TD></TR><TR><TD ALIGN="LEFT">health</TD></TR><TR><TD ALIGN="LEFT">attack</TD></TR><TR><TD ALIGN="LEFT">defense</TD></TR><TR><TD ALIGN="LEFT">reward_money</TD></TR><TR><TD ALIGN="LEFT">reward_xp</TD></TR><TR><TD ALIGN="LEFT">dodge_chance</TD></TR><TR><TD ALIGN="LEFT">crit_chance</TD></TR></TABLE>>];
  combats [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fecaca"><B>combats</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK character_id</TD></TR><TR><TD ALIGN="LEFT">FK enemy_id</TD></TR><TR><TD ALIGN="LEFT">result</TD></TR><TR><TD ALIGN="LEFT">turns</TD></TR><TR><TD ALIGN="LEFT">damage_dealt / damage_taken</TD></TR><TR><TD ALIGN="LEFT">xp_gained</TD></TR><TR><TD ALIGN="LEFT">money_gained</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  missions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#dcfce7"><B>missions</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">name (UNIQUE)</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">difficulty</TD></TR><TR><TD ALIGN="LEFT">min_level</TD></TR><TR><TD ALIGN="LEFT">reward_money</TD></TR><TR><TD ALIGN="LEFT">reward_xp</TD></TR><TR><TD ALIGN="LEFT">objective_type</TD></TR><TR><TD ALIGN="LEFT">FK objective_target_id</TD></TR><TR><TD ALIGN="LEFT">objective_amount</TD></TR></TABLE>>];
  character_missions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#bbf7d0"><B>character_missions</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK,FK character_id</TD></TR><TR><TD ALIGN="LEFT">PK,FK mission_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">progress</TD></TR><TR><TD ALIGN="LEFT">accepted_at</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR></TABLE>>];
  activity_logs [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e5e7eb"><B>activity_logs</B></TD></TR><HR/><TR><TD ALIGN="LEFT">PK id</TD></TR><TR><TD ALIGN="LEFT">FK user_id</TD></TR><TR><TD ALIGN="LEFT">FK character_id</TD></TR><TR><TD ALIGN="LEFT">action</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
  users -> characters [taillabel="1", headlabel="1", label="1:1"];
  characters -> inventory [taillabel="1", headlabel="N", label="1:N"];
  items -> inventory [taillabel="1", headlabel="N", label="1:N"];
  characters -> transactions [taillabel="1", headlabel="N", label=""];
  items -> transactions [taillabel="1", headlabel="N", label=""];
  characters -> combats [taillabel="1", headlabel="N", label=""];
  enemies -> combats [taillabel="1", headlabel="N", label=""];
  characters -> character_missions [taillabel="1", headlabel="N", label=""];
  missions -> character_missions [taillabel="1", headlabel="N", label=""];
  enemies -> missions [taillabel="1", headlabel="N", label="alvo (0..1)"];
  users -> activity_logs [taillabel="1", headlabel="N", label=""];
  characters -> activity_logs [taillabel="1", headlabel="N", label=""];
}
